;; What this vertical's robot physically does, declared for
;; kotoba.robotics.process (kotoba-lang/robotics). `kbb -M:physics` runs it.
;;
;; README "Robotics premise": a job-site scheduling/logistics coordination
;; robot for insulation workers (ISCO 7124) schedules the crew, logs
;; materials usage and progress, and coordinates insulation supply orders; it
;; never installs insulation. Its physical work is moving bulky, light
;; insulation packs across the site; the physics behind the insulation it
;; orders is how thick a pipe lagging must be to keep its outer surface safe
;; to touch.
;;
;; Every number without a cited source is marked `estimate` in its :basis.
;; Replacing an estimate with a sourced value is this bot's growth work.
{:physics/schema "itonami.physical-ai.spec.v1"
 :repo "cloud-itonami/cloud-itonami-isco-7124"
 :cases
 [{:id :insulation-pack-tipover
   :kind :transport
   :procedure "logistics robot carries a stack of compressed mineral-wool / PIR board packs 60 m across the site; the stack height (its centre of mass) is swept"
   :params {:mass-kg 90.0 :payload-kg 80.0 :distance-m 60.0 :v-max-mps 1.2 :a-max-mps2 0.6
            :brake-decel-mps2 1.2 :drive-force-n 300.0 :crr 0.03
            :cog-height-m 0.35 :support-half-length-m 0.35}
   :sweep {:param :payload-cog-height-m :values [0.6 1.0 1.4 1.8 2.2 2.8]}
   :quantity :min-tipover-margin
   :limit {:min 0.5 :basis "estimate: keep half of the static longitudinal stability margin in reserve for wind on a bulky light load and uneven ground"}
   :boundary {:lo 0.4 :hi 4.0}}
  {:id :steam-pipe-lagging
   :kind :thermal
   :procedure "mineral-wool lagging on a 180 C steam line (treated as a flat slab), outer face in 20 C still air for 3 h; lagging thickness is swept to find the touch-safe thickness the supply order must specify"
   :params {:conductivity-w-mk 0.045 :density-kg-m3 100.0 :specific-heat-j-kgk 840.0
            :t0-c 20.0 :t-hot-c 180.0 :front-fixed? true
            :t-back-ambient-c 20.0 :h-back-w-m2k 8.0 :threshold-c 55.0 :duration-s 10800.0}
   :sweep {:param :thickness-m :values [0.010 0.020 0.030 0.050 0.080]}
   :quantity :peak-back-c
   :limit {:max 55.0 :basis "estimate: order of the surface temperature commonly treated as touch-safe for long contact with metal-jacketed insulation; the exact contact-burn threshold (e.g. ISO 13732-1) is not verified here"}
   :boundary {:lo 0.005 :hi 0.12}}]}
